# Compiler Lab API — copy to backend/.env and fill in values.

# SQLite for local development (zero setup).
# For production (Render + Neon), set this to the Neon Postgres connection string
# in the Render dashboard instead — do NOT commit a real Postgres URL.
DATABASE_URL=sqlite:///./compiler_lab.db

# Change this to a long random string in production (e.g. openssl rand -hex 32).
JWT_SECRET=change-me-to-a-long-random-string

JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

ENV=development
